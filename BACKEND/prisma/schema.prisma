generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Discipline {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  slug         String   @unique @db.VarChar(120)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  topics Topic[]

  @@map("disciplines")
}

model Topic {
  id           Int      @id @default(autoincrement())
  disciplineId Int      @map("discipline_id")
  name         String   @db.VarChar(160)
  slug         String   @db.VarChar(160)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  subtopics  Subtopic[]

  @@unique([disciplineId, slug])
  @@index([disciplineId])
  @@map("topics")
}

model Subtopic {
  id           Int      @id @default(autoincrement())
  topicId      Int      @map("topic_id")
  name         String   @db.VarChar(180)
  slug         String   @db.VarChar(180)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  topic                Topic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  statements           Statement[]
  knowledgeItems       KnowledgeItem[]
  classificationGroups ClassificationGroup[]
  examQuestions        ExamQuestion[]
  conceptQuestions     ConceptQuestion[]
  clozeQuestions       ClozeQuestion[]

  @@unique([topicId, slug])
  @@index([topicId])
  @@map("subtopics")
}

model ConceptQuestion {
  id         Int      @id @default(autoincrement())
  subtopicId Int      @map("subtopic_id")
  question   String
  answer     String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@index([subtopicId])
  @@index([subtopicId, isActive])
  @@map("concept_questions")
}

model ClozeQuestion {
  id              Int      @id @default(autoincrement())
  subtopicId      Int      @map("subtopic_id")
  textWithAnswers String   @map("text_with_answers")
  isDifficult     Boolean  @default(false) @map("is_difficult")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  @@index([subtopicId])
  @@index([subtopicId, isActive])
  @@index([subtopicId, isDifficult])
  @@map("cloze_questions")
}

model ExamBoard {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  exams     Exam[]
  questions ExamQuestion[]

  @@map("exam_boards")
}

model Exam {
  id        Int      @id @default(autoincrement())
  boardId   Int      @map("board_id")
  name      String   @db.VarChar(240)
  year      Int?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board     ExamBoard      @relation(fields: [boardId], references: [id], onDelete: Restrict)
  questions ExamQuestion[]

  @@unique([boardId, name, year])
  @@index([boardId])
  @@map("exams")
}

model ExamQuestion {
  id          Int      @id @default(autoincrement())
  subtopicId  Int      @map("subtopic_id")
  boardId     Int?     @map("board_id")
  examId      Int?     @map("exam_id")
  text        String
  explanation String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subtopic Subtopic             @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  board    ExamBoard?           @relation(fields: [boardId], references: [id], onDelete: SetNull)
  exam     Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  options  ExamQuestionOption[]

  @@index([subtopicId])
  @@index([boardId])
  @@index([examId])
  @@map("exam_questions")
}

model ExamQuestionOption {
  id           Int     @id @default(autoincrement())
  questionId   Int     @map("question_id")
  text         String
  isCorrect    Boolean @default(false) @map("is_correct")
  displayOrder Int     @default(0) @map("display_order")

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("exam_question_options")
}

model Statement {
  id            Int      @id @default(autoincrement())
  subtopicId    Int      @map("subtopic_id")
  text          String   @db.VarChar(2000)
  correctAnswer Boolean  @map("correct_answer")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  attempts AnswerAttempt[]
  progress StatementProgress?

  @@index([subtopicId])
  @@index([subtopicId, isActive])
  @@map("statements")
}

model AnswerAttempt {
  id             Int      @id @default(autoincrement())
  statementId    Int      @map("statement_id")
  selectedAnswer Boolean  @map("selected_answer")
  isCorrect      Boolean  @map("is_correct")
  answeredAt     DateTime @default(now()) @map("answered_at")

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([answeredAt])
  @@index([isCorrect])
  @@map("answer_attempts")
}

model StatementProgress {
  id                 Int       @id @default(autoincrement())
  statementId        Int       @unique @map("statement_id")
  totalAttempts      Int       @default(0) @map("total_attempts")
  correctAttempts    Int       @default(0) @map("correct_attempts")
  incorrectAttempts  Int       @default(0) @map("incorrect_attempts")
  consecutiveCorrect Int       @default(0) @map("consecutive_correct")
  lastResult         Boolean?  @map("last_result")
  lastAnsweredAt     DateTime? @map("last_answered_at")
  nextReviewAt       DateTime? @map("next_review_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([nextReviewAt])
  @@index([lastResult])
  @@map("statement_progress")
}

model KnowledgeItem {
  id          Int      @id @default(autoincrement())
  subtopicId  Int      @map("subtopic_id")
  text        String
  explanation String?
  reference   String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)

  // Domain invariant: an item may only use categories whose group belongs to the same subtopic.
  classifications ItemClassification[]
  progress        KnowledgeItemProgress?

  @@index([subtopicId])
  @@map("knowledge_items")
}

model ClassificationGroup {
  id          Int      @id @default(autoincrement())
  subtopicId  Int      @map("subtopic_id")
  name        String   @db.VarChar(160)
  instruction String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subtopic   Subtopic                 @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  categories ClassificationCategory[]

  @@unique([subtopicId, name])
  @@index([subtopicId])
  @@map("classification_groups")
}

model ClassificationCategory {
  id           Int    @id @default(autoincrement())
  groupId      Int    @map("group_id")
  name         String @db.VarChar(160)
  displayOrder Int    @default(0) @map("display_order")

  group           ClassificationGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  classifications ItemClassification[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("classification_categories")
}

model ItemClassification {
  id         Int @id @default(autoincrement())
  itemId     Int @map("item_id")
  categoryId Int @map("category_id")

  item     KnowledgeItem          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category ClassificationCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([itemId, categoryId])
  @@index([itemId])
  @@index([categoryId])
  @@map("item_classifications")
}

model KnowledgeItemProgress {
  id                 Int       @id @default(autoincrement())
  itemId             Int       @unique @map("item_id")
  totalAttempts      Int       @default(0) @map("total_attempts")
  correctAttempts    Int       @default(0) @map("correct_attempts")
  incorrectAttempts  Int       @default(0) @map("incorrect_attempts")
  consecutiveCorrect Int       @default(0) @map("consecutive_correct")
  lastResult         Boolean?  @map("last_result")
  lastAnsweredAt     DateTime? @map("last_answered_at")
  nextReviewAt       DateTime? @map("next_review_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  item KnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([nextReviewAt])
  @@map("knowledge_item_progress")
}
